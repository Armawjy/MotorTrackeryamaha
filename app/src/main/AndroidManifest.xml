        android:supportsRtl="true"
        android:theme="@style/Theme.MotorTrackeryamaha">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AddOilChangeActivity"
            android:exported="false"
            android:label="Catat Ganti Oli" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:label="Profil Motor" />
        <activity
            android:name=".TrackingActivity"
            android:exported="false"
            android:label="Perjalanan" />
        <activity
            android:name=".MaintenanceActivity"
            android:exported="false"
            android:label="Perawatan" />
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="Riwayat" />
        <activity
            android:name=".StatisticsActivity"
            android:exported="false"
            android:label="Statistik" />
        <activity
            android:name=".NotificationsActivity"
            android:exported="false"
            android:label="Notifikasi" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="Pengaturan" />
        <activity
            android:name=".ui.settings.BackupRestoreActivity"
            android:exported="false"
            android:label="Backup &amp; Restore" />
        <activity
            android:name=".ProfileAccountActivity"
            android:exported="false"
            android:label="Profil Akun" />
        <activity
            android:name=".SecurityPrivacyActivity"
            android:exported="false"
            android:label="Keamanan &amp; Privasi" />
        <activity
            android:name=".NotificationSettingsActivity"
            android:exported="false"
            android:label="Pengaturan Notifikasi" />
        <activity
            android:name=".LocationSettingsActivity"
            android:exported="false"
