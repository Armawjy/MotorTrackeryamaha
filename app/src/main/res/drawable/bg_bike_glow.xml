<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background_dark" />
        </shape>
    </item>
    <!-- Circular platform glow -->
    <item android:bottom="20dp" android:left="40dp" android:right="20dp" android:top="120dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#332196F3"
                android:endColor="@android:color/transparent"
                android:gradientRadius="150dp"
                android:startColor="#662196F3"
                android:type="radial" />
        </shape>
    </item>
    <!-- Streaks/Lines simplified representation -->
    <item>
        <rotate
            android:fromDegrees="15"
            android:pivotX="0%"
            android:pivotY="100%">
            <shape android:shape="rectangle">
                <size android:height="1dp" />
                <solid android:color="#1A2196F3" />
            </shape>
        </rotate>
    </item>
</layer-list>